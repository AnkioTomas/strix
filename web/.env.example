# Copy to web/.env and edit. Shell exports still win over this file.
# cp .env.example .env
# Or just run from repo root: ./scripts/start-web.sh  (copies this file on first run)

# --- Web API ---
STRIX_API_KEY=dev-local
# STRIX_API_AUTH_DISABLED=0
STRIX_API_HOST=127.0.0.1
STRIX_API_PORT=8787
# STRIX_API_DATA_DIR=./data

STRIX_ALLOW_PRIVATE_TARGETS=1
# Hard ceiling; real parallelism packs ~30% CPU (top-style) + 2GiB per task.
STRIX_MAX_CONCURRENT=8
STRIX_TASK_CPU_PERCENT=30
STRIX_TASK_MEMORY_GB=2

# --- Strix LLM / infra (loaded into process env) ---
STRIX_LLM=openai/mtplx-flash-next-bare-speed
LLM_API_KEY=sk-local
OPENAI_API_BASE=http://127.0.0.1:8000/v1
LLM_TIMEOUT=300
# Report narrative language (zh/en/ja/Français/…); empty = unset
STRIX_REPORT_LANGUAGE=zh
