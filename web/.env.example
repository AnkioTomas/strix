# Copy to web/.env and edit. Shell exports still win over this file.
# cp .env.example .env
# Or just run from repo root: ./scripts/start-web.sh  (copies this file on first run)

# --- Web API ---
STRIX_API_KEY=dev-local
# STRIX_API_AUTH_DISABLED=0
STRIX_API_HOST=127.0.0.1
STRIX_API_PORT=8787
# STRIX_API_DATA_DIR=./data

STRIX_ALLOW_PRIVATE_TARGETS=1

# Gitea HTTPS clone for audit tasks (full repo URL goes on the task, not here).
# Username + token must be set together; never stored on the task.
# Token needs repo read (clone) + issues write when STRIX_GITEA_ISSUES=1.
# STRIX_GIT_USERNAME=bot
# STRIX_GIT_TOKEN=
# After a completed audit (git source), auto-create one Issue per finding.
# STRIX_GITEA_ISSUES=1

# Hard ceiling; real parallelism packs ~30% CPU (top-style) + 2GiB per task.
STRIX_MAX_CONCURRENT=8
STRIX_TASK_CPU_PERCENT=30
STRIX_TASK_MEMORY_GB=2

# Feishu group bot webhook (empty = off). Web polls task status / agents.json;
# does not require changes to Strix core. Web must be running to deliver.
# STRIX_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# STRIX_FEISHU_EVENTS=started,finished,failed,cancelled,needs_user
# Outbound HTTP(S) proxy for Feishu only (not the agent sandbox proxy).
# STRIX_FEISHU_PROXY=http://127.0.0.1:7890

# --- Strix LLM / infra (loaded into process env) ---
STRIX_LLM=openai/mtplx-flash-next-bare-speed
LLM_API_KEY=sk-local
OPENAI_API_BASE=http://127.0.0.1:8000/v1
LLM_TIMEOUT=300
# Report narrative language (zh/en/ja/Français/…); empty = unset
STRIX_REPORT_LANGUAGE=zh
